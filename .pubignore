# Files NOT to ship to pub.dev. Pub falls back to .gitignore by default;
# this file overrides that for files git tracks but pub shouldn't ship.

# llama.cpp source submodule. Release packages carry only the staged Android
# AAR under /native/android/ and the Apple SwiftPM binary target metadata.
# Anchored with leading `/` so it doesn't also match `lib/src/`.
/src/

# Native build artifacts and maintainer scripts. Do not exclude /native/: its
# verified Android AAR is intentionally staged into release packages.
/build/
/tool/

# Internal hand-off docs. Useful in the repo, noise on pub.dev.
HANDOFF.md
HANDOFF_M10.md
llama_cpp.podspec

# CI workflow definitions (not useful to package consumers).
.github/

# Editor / OS junk.
.vscode/
.idea/
*.iml
.dart_tool/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Stray example log files.
rag_log.txt
